# OpenCompete 本地 CLI 默认模型需要。请只在本地 .env 填写，不要提交真实密钥。
OPENAI_API_KEY=

# 使用第三方 OpenAI 兼容供应商时填写。BASE_URL 通常是服务根地址或以 /v1 结尾的 API 根地址；
# 具体是否需要补充 /v1 由供应商接口决定。OPENAI_MODEL 填供应商实际开放的模型标识。
OPENAI_BASE_URL=
OPENAI_MODEL=

# OpenCompete 正式搜索固定使用 Tavily；运行真实研究时需要。
TAVILY_API_KEY=

# 仅在 opencompete.toml 选择对应模型供应商时填写。
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# 可选的上游 LangSmith 观测变量；OpenCompete 正式功能不依赖它们。
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=

# 以下变量只供上游 Open Agent Platform 兼容调试，OpenCompete CLI 不读取。
SUPABASE_KEY=
SUPABASE_URL=
GET_API_KEYS_FROM_CONFIG=false
