  "research_request": {
    "query": "以 2026-07-17 为截止日，为 250 人美国混合办公知识型企业比较 Microsoft 365 与 Google Workspace。必须映射等价 SKU，覆盖邮件、会议、文档、文件、桌面与浏览器工作流、身份和设备、安全与合规、AI 治理、支持与 SLA、迁移切换成本和三年 TCO；按 Windows/Office 重度、浏览器优先、受监管三类组织场景给出条件化建议。动态价格和未经租户测试的效果必须写为 Unknown。",
    "entities": [{"name": "Microsoft 365"}, {"name": "Google Workspace"}],
    "levels": ["product_service"],
