        "capabilities", "pricing", "user_experience", "technology_integrations", "service_support",
        "workflow_fit", "sku_entitlements", "identity_device_security", "compliance_data_governance",
        "ai_governance", "migration_switching", "total_cost_of_ownership", "support_sla"
